# 复制为 .env 并填入你的智谱 GLM key（https://open.bigmodel.cn/）
# 没填 key 时会自动用本地兜底讲稿，填了就走真实 GLM 生成。
ZHIPU_API_KEY=

# 模型：glm-4-flash 免费够用；想要更好的讲稿质量可换 glm-4-flashx / glm-4-air / glm-4-plus
GLM_MODEL=glm-4-flash

# GLM 调用超时（毫秒），超时会返回提示而不是一直卡在加载页
GLM_TIMEOUT_MS=45000

# 云端语音（智谱 cogtts）—— 复用上面的 ZHIPU_API_KEY，但语音合成是付费的，
# 需要在 open.bigmodel.cn 充值/购买资源包后才可用；没余额时前端会自动回退到浏览器语音。
ZHIPU_TTS_MODEL=cogtts
ZHIPU_TTS_VOICE=tongtong
TTS_TIMEOUT_MS=30000

PORT=8787

# 防刷:花钱端点(讲稿/语音/导览)每 IP 每分钟请求上限
RATE_LIMIT_PER_MIN=20

# widget 跨域白名单:逗号分隔的站点 Origin(如 https://ardencosmic.com,https://demo.example.com)。
# 留空或 * = 全部放行(方便试用);正式商用后务必收紧到客户域名。
WIDGET_ALLOWED_ORIGINS=

# TTS 音频缓存目录(留空 = 系统临时目录;同一段讲稿只付费合成一次)
TTS_CACHE_DIR=

# Supabase Auth（可选）——填了就是真账号系统，没填则用本地点击即进的演示登录。
# 在 supabase.com 建项目，Project Settings → API 拿到这两个值。
# 注意：anon key 是 PUBLIC key，可以暴露给前端；不要把 service_role key 放这里。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
