# 复制为 .env 并填入你的智谱 GLM key（https://open.bigmodel.cn/）
# 没填 key 时会自动用本地兜底讲稿，填了就走真实 GLM 生成。
ZHIPU_API_KEY=

# 模型：glm-4-flash 免费够用；想要更好的讲稿质量可换 glm-4-flashx / glm-4-air / glm-4-plus
GLM_MODEL=glm-4-flash

# GLM 调用超时（毫秒），超时会返回提示而不是一直卡在加载页
GLM_TIMEOUT_MS=45000

PORT=8787

# 登录令牌签名密钥，部署时务必修改
TOKEN_SECRET=change-me-in-production
