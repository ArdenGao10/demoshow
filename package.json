{
  "name": "demi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demi — 不用出镜的 AI 演示助手。选形态 → 上传 HTML PPT → GLM 生成讲稿 → 逐页语音+动效播放。",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
